		},
		{
			"id": "tax.service",
			"label": "Service tax template",
			"expected": "Service Tax 8% - SM",
			"where": "Item Tax Template"
		},
		{
			"id": "uom.conversion",
			"label": "1 Box equals",
			"expected": "12 Nos",
			"where": "UOM Conversion Factor"
		},
		{
			"id": "stock.warehouses",
