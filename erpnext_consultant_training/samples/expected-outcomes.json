{
	"company": "Seri Murni Sdn Bhd",
	"abbreviation": "SM",
	"currency": "MYR",
	"fiscal_year": "2026-01-01 to 2026-12-31",
	"valuation_method": "FIFO",
	"setup_checks": [
		{
			"id": "company.roots",
			"label": "Account root groups",
			"expected": "5",
			"where": "Chart of Accounts"
		},
		{
			"id": "company.suffix",
			"label": "Account name suffix",
			"expected": "- SM",
			"where": "Any ledger account"
		},
		{
			"id": "company.receivable",
			"label": "Default receivable",
			"expected": "Debtors - SM",
			"where": "Company → Accounts"
		},
		{
			"id": "company.cost_centres",
			"label": "Cost centres",
			"expected": "Main, Retail, Showroom, Assembly",
			"where": "Cost Center list"
		},
		{
			"id": "tax.sales",
			"label": "Sales tax template",
