{
  "name": "erpnext-mobile-inventory",
  "private": true,
  "version": "0.1.0",
  "description": "Offline-first mobile inventory PWA for ERPNext (scan, receive, issue, transfer, count)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "serve": "node scripts/serve-dist.mjs",
    "lint": "eslint .",
    "test": "node --test \"tests/*.test.mjs\"",
    "check": "npm run lint && npm test && npm run build && npm run smoke",
    "smoke": "node tests/smoke.mjs"
  },
  "dependencies": {
    "@zxing/browser": "^0.1.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.30.0",
    "globals": "^16.0.0",
    "jsdom": "^30.1.3",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.40.0",
    "vite": "^7.0.0"
  }
}
